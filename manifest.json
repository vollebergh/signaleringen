{
  "manifest_version": 3,
  "name": "Signaleringen",
  "version": "0.21.12",
  "description": "Volgt RSS-feeds, webpagina's en open.overheid.nl per profiel en bundelt relevante publicaties tot één signalering per onderwerp.",
  "minimum_chrome_version": "121",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "scripts": ["src/background/service-worker.js"],
    "type": "module"
  },

  "action": {
    "default_popup": "src/ui/popup/popup.html",
    "default_title": "Signaleringen"
  },

  "options_page": "src/ui/dashboard/dashboard.html",

  "side_panel": {
    "default_path": "src/ui/sidepanel/sidepanel.html"
  },

  "sidebar_action": {
    "default_panel": "src/ui/sidepanel/sidepanel.html",
    "default_title": "Signaleringen",
    "default_icon": "icons/icon-32.png",
    "open_at_install": false
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "signaleringen@vollebergh",
      "strict_min_version": "128.0"
    }
  },

  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel"
  ],

  "optional_permissions": [
    "alarms"
  ],

  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
